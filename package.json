{
  "name": "koishi-plugin-deepseek-keyusage",
  "version": "1.2.0",
  "description": "DeepSeek API Key 用量查询：余额、花费、Token 与缓存命中率，支持一人多 Key",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "xjkoharu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xjkoharu/koishi-plugin-deepseek-keyusage.git"
  },
  "homepage": "https://github.com/xjkoharu/koishi-plugin-deepseek-keyusage#readme",
  "bugs": {
    "url": "https://github.com/xjkoharu/koishi-plugin-deepseek-keyusage/issues"
  },
  "keywords": [
    "koishi",
    "plugin",
    "deepseek",
    "usage",
    "qq"
  ],
  "engines": {
    "node": ">=18"
  },
  "koishi": {
    "description": {
      "zh": "查询 DeepSeek API Key 的余额、花费与 Token 用量，支持多账号多 Key、Key 尾号绑定",
      "en": "Query DeepSeek API key balance, spending and token usage, with multi-account, multi-key and key-suffix binding"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "devDependencies": {
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@koishijs/plugin-mock": "^2.6.6",
    "@types/node": "^22.10.0",
    "koishi": "^4.18.11",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
